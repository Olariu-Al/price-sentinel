# NOTE: the Finnhub and Resend API keys are NOT here. They live in your 1Claw vault.

# --- 1Claw (required) ---
ONECLAW_AGENT_ID=<agent-uuid>
ONECLAW_AGENT_API_KEY=ocv_<agent-key>
# Required in MODE=vault only
ONECLAW_VAULT_ID=<vault-uuid>
# ONECLAW_BASE_URL=https://api.1claw.co

# --- What to watch (required) ---
SYMBOL=AAPL
THRESHOLD=200
ALERT_TO=you@example.com

# --- Optional (defaults shown) ---
# DIRECTION=above                 # above | below
# ALERT_FROM=Price Sentinel <onboarding@resend.dev>
# INTERVAL_SECONDS=300            # integer, minimum 30
# STATE_FILE=.state.json

# vault   = agent reads both keys from the vault on every check and calls the APIs itself
# intents = 1Claw calls the APIs through bindings; keys never leave the vault
# MODE=vault
# FINNHUB_SECRET_PATH=price-sentinel/finnhub-api-key   # vault mode
# RESEND_SECRET_PATH=price-sentinel/resend-api-key     # vault mode
# FINNHUB_BINDING=finnhub                              # intents mode
# RESEND_BINDING=resend                                # intents mode
